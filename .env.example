# Copy to `.env` before running `docker compose up`:
#
#   cp .env.example .env

# SQLite — used by the Rust backend (`crates/mlrs-server`) via DATABASE_URL.
# The default resolves to `.mlrs-data/mlrs.db` relative to the working directory;
# the Compose stack overrides it with an absolute path under the data volume.
DATABASE_URL=sqlite:////var/lib/mlrs/mlrs.db
MLRS_DATA_DIR=/var/lib/mlrs

# Frontend -> backend base URL. This is read by the browser, so it must be an
# address reachable from the host. It is also inlined into the frontend build.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Link to the interactive API reference shown in the app footer. Defaults to
# `${NEXT_PUBLIC_API_URL}/docs` when empty.
NEXT_PUBLIC_API_DOCS_URL=

# Backend upload cap in MiB for POST /api/v1/datasets (NFR-030). Defaults to 10.
MLRS_MAX_UPLOAD_MB=10

# Root log level of the backend logger: DEBUG, INFO, WARNING, or ERROR.
MLRS_LOG_LEVEL=INFO

# Comma-separated allow-list of browser origins permitted to call the API.
# Entries are scheme + host (+ optional port) with no trailing slash.
MLRS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Whether CORS responses may carry `Access-Control-Allow-Credentials`.
# Must be false when MLRS_CORS_ORIGINS contains `*`.
MLRS_CORS_ALLOW_CREDENTIALS=true

# Whether the interactive API reference (/docs, /redoc, /openapi.json) is served.
MLRS_ENABLE_INTERACTIVE_DOCS=true

# Worker limits: concurrent jobs, per-attempt timeout, total attempts, the
# exponential-backoff base, and the age after which a job left behind by a
# crashed process is marked failed.
MLRS_MAX_CONCURRENT_JOBS=1
MLRS_JOB_TIMEOUT_SECONDS=1800
MLRS_JOB_MAX_ATTEMPTS=2
MLRS_JOB_RETRY_BASE_SECONDS=2
MLRS_WORKER_STALE_SECONDS=3600

# Rate limiting: enabled flag, max requests per window, and window seconds.
MLRS_RATE_LIMIT_ENABLED=true
MLRS_RATE_LIMIT_MAX_REQUESTS=100
MLRS_RATE_LIMIT_WINDOW_SECONDS=60

# Response compression: enabled flag and minimum response size in bytes.
MLRS_COMPRESSION_ENABLED=true
MLRS_COMPRESSION_MIN_SIZE=500

# Wall-clock budget for a single HTTP request before the middleware answers
# 503 REQUEST_TIMEOUT.
MLRS_REQUEST_TIMEOUT_SECONDS=30
