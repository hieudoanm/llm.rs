{
  "productName": "Local Learning Machine",
  "version": "0.1.0",
  "identifier": "com.llm.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Local Learning Machine",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
